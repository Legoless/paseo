#!/bin/sh
set -eu

SCRIPT_PATH=$0
case "$SCRIPT_PATH" in
  /*) ;;
  *) SCRIPT_PATH="$(pwd)/$SCRIPT_PATH" ;;
esac

# Follow symlinks so `/usr/local/bin/paseo` resolves back into the app bundle.
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}" ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
RESOURCES_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

MACOS_DIR="${RESOURCES_DIR}/../MacOS"

# macOS CLI invocations must enter Electron through the agent Helper. Launching
# the main APPL executable here makes later daemon supervision inherit app UI
# lifecycle behavior.
if [ -d "${MACOS_DIR}" ]; then
  # The Helper is named after the main executable, so renamed builds such as
  # Paseo Neo resolve theirs too. Electron bundles ship one file in MacOS.
  for MACOS_EXECUTABLE in "${MACOS_DIR}"/*; do break; done
  APP_NAME=$(basename "${MACOS_EXECUTABLE}")
  MACOS_HELPER_EXECUTABLE="${RESOURCES_DIR}/../Frameworks/${APP_NAME} Helper.app/Contents/MacOS/${APP_NAME} Helper"
  if [ ! -x "${MACOS_HELPER_EXECUTABLE}" ]; then
    echo "Bundled Paseo Helper executable not found at ${MACOS_HELPER_EXECUTABLE}" >&2
    exit 1
  fi
  APP_EXECUTABLE="${MACOS_HELPER_EXECUTABLE}"
else
  # Linux names the executable after the product too, so match on shape.
  # `.bin` first: electron-builder's launcher wrapper shares the product name
  # with the real binary beside it.
  APP_EXECUTABLE=""
  for CANDIDATE in "${RESOURCES_DIR}"/../*.bin "${RESOURCES_DIR}"/../*; do
    if [ -f "${CANDIDATE}" ] && [ -x "${CANDIDATE}" ]; then
      APP_EXECUTABLE="${CANDIDATE}"
      break
    fi
  done
  if [ -z "${APP_EXECUTABLE}" ]; then
    echo "Bundled Paseo executable not found relative to ${RESOURCES_DIR}" >&2
    exit 1
  fi
fi

RUNNER_PATH="${RESOURCES_DIR}/app.asar.unpacked/dist/daemon/node-entrypoint-runner.js"
CLI_ENTRYPOINT="${RESOURCES_DIR}/app.asar/node_modules/@getpaseo/cli/dist/index.js"

# Neo runs its own daemon on its own home and port so it can sit beside the
# official app. Without this the CLI would default to ~/.paseo on 6767 and talk
# to the wrong daemon, or to none at all. An explicit value from the caller
# still wins. Keep in step with NEO_PASEO_HOME/NEO_PASEO_LISTEN in
# src/variant.ts; cli-bin-name.test.ts fails if they drift.
VARIANT_MANIFEST="${RESOURCES_DIR}/variant.json"
if [ -f "${VARIANT_MANIFEST}" ] && grep -q '"variant"[[:space:]]*:[[:space:]]*"neo"' "${VARIANT_MANIFEST}"; then
  PASEO_HOME="${PASEO_HOME:-${HOME}/.paseo-neo}"
  PASEO_LISTEN="${PASEO_LISTEN:-127.0.0.1:6768}"
  export PASEO_HOME PASEO_LISTEN
fi

exec env ELECTRON_RUN_AS_NODE=1 PASEO_NODE_ENV=production PASEO_CLI="${SCRIPT_PATH}" "${APP_EXECUTABLE}" --disable-warning=DEP0040 "${RUNNER_PATH}" node-script "${CLI_ENTRYPOINT}" "$@"
